<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HubLink.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="HubLink.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HubLink - Regional Logistics Data Exchange"
        Width="1150" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
        
        <!-- Header & Config Panel -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                BoxShadow="0 2 8 0 #15000000">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="HubLink Operations Portal" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Regional Centralized Shipment Tracking &amp; Export" FontSize="13" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Fetch / Refresh"
                            Command="{Binding FetchShipmentsCommand}"
                            Background="#2563EB" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Padding="14,8"
                            CornerRadius="6"/>
                    <Button Content="Export Displayed CSV"
                            Command="{Binding ExportCsvCommand}"
                            Background="#059669" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Padding="14,8"
                            CornerRadius="6"/>
                </StackPanel>

                <!-- Configuration Bar -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                    <TextBlock Text="Service Base URL:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding BaseAddress, Mode=TwoWay}" Padding="6,4" Margin="0,0,16,0" CornerRadius="4"/>

                    <TextBlock Grid.Column="2" Text="Branch Code:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="3" Text="{Binding BranchCode, Mode=TwoWay}" Width="110" Padding="6,4" Margin="0,0,16,0" CornerRadius="4"/>

                    <CheckBox Grid.Column="4" IsChecked="{Binding UseTestEndpoint, Mode=TwoWay}" Content="Test Endpoint" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="5" Text="Mode:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155" Margin="0,0,6,0"
                               IsVisible="{Binding UseTestEndpoint}"/>
                    <ComboBox Grid.Column="6" ItemsSource="{Binding TestModes}" SelectedItem="{Binding SelectedTestMode, Mode=TwoWay}"
                              Width="130" IsVisible="{Binding UseTestEndpoint}" CornerRadius="4"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Operational Summary Cards -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                BoxShadow="0 2 8 0 #15000000">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <!-- Total -->
                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Total Shipments" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBlock Text="{Binding Summary.Total}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Pending -->
                <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="6" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Pending" FontSize="12" FontWeight="SemiBold" Foreground="#B45309"/>
                        <TextBlock Text="{Binding Summary.Pending}" FontSize="24" FontWeight="Bold" Foreground="#92400E" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- InTransit -->
                <Border Grid.Column="2" Background="#DBEAFE" CornerRadius="6" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="In Transit" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        <TextBlock Text="{Binding Summary.InTransit}" FontSize="24" FontWeight="Bold" Foreground="#1E40AF" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Delivered -->
                <Border Grid.Column="3" Background="#D1FAE5" CornerRadius="6" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Delivered" FontSize="12" FontWeight="SemiBold" Foreground="#047857"/>
                        <TextBlock Text="{Binding Summary.Delivered}" FontSize="24" FontWeight="Bold" Foreground="#065F46" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Exception -->
                <Border Grid.Column="4" Background="#FEE2E2" CornerRadius="6" Padding="12" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Exception" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C"/>
                        <TextBlock Text="{Binding Summary.Exception}" FontSize="24" FontWeight="Bold" Foreground="#991B1B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Status Filter & Controls Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                BoxShadow="0 2 8 0 #15000000">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Filter by Status:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                          Width="160" CornerRadius="4"/>

                <!-- Stale Data Notice Banner -->
                <Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="16,0,0,0"
                        IsVisible="{Binding HasStaleData}">
                    <TextBlock Text="{Binding StaleDataNotice}" Foreground="#92400E" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="3" Text="{Binding DisplayedShipments.Count, StringFormat='Showing {0} records'}"
                           VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- DataGrid of Shipments -->
        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="8" Padding="8" BoxShadow="0 2 8 0 #15000000">
            <DataGrid ItemsSource="{Binding DisplayedShipments}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="All"
                      CanUserResizeColumns="True"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tracking Number" Binding="{Binding TrackingNumber}" Width="140" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="200"/>
                    <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="200"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Last Updated (UTC)" Binding="{Binding FormattedUtcTime}" Width="180"/>
                    <DataGridTextColumn Header="Last Updated (Local)" Binding="{Binding FormattedLocalTime}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status & Feedback Footer -->
        <Border Grid.Row="4" Background="#FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                BoxShadow="0 2 8 0 #15000000">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Spinner / Loading indicator -->
                <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="100" Height="6" Margin="0,0,12,0"
                             IsVisible="{Binding IsLoading}"/>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           FontWeight="Medium" FontSize="13" Foreground="#1E293B"/>

                <TextBlock Grid.Column="2" Text="PT5 Regional Logistics Exchange" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
