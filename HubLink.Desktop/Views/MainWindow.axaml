<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HubLink.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1160" d:DesignHeight="760"
        x:Class="HubLink.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HubLink - Regional Logistics Data Exchange"
        Width="1160" Height="760"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="20">

        <!-- 1. Header & Configuration Card -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="10" Padding="18" Margin="0,0,0,12"
                BoxShadow="0 1 4 0 #0F000000">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Text="HubLink Operations Portal" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Regional Centralized Shipment Tracking &amp; Reporting" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="|" FontSize="13" Foreground="#CBD5E1"/>
                        <TextBlock Text="{Binding LastSyncedText}" FontSize="13" FontWeight="Medium" Foreground="#475569"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="Fetch Shipments"
                            Command="{Binding FetchShipmentsCommand}"
                            IsEnabled="{Binding IsNotLoading}"
                            Background="#2563EB" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Padding="16,9"
                            CornerRadius="6"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelFetchCommand}"
                            IsVisible="{Binding IsLoading}"
                            Background="#DC2626" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Padding="14,9"
                            CornerRadius="6"/>
                    <Button Content="Export CSV"
                            Command="{Binding ExportCsvCommand}"
                            IsEnabled="{Binding IsNotLoading}"
                            Background="#059669" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Padding="16,9"
                            CornerRadius="6"/>
                </StackPanel>

                <!-- Configuration Controls -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Service Base URL" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding BaseAddress, Mode=TwoWay}"
                                 IsEnabled="{Binding IsNotLoading}"
                                 PlaceholderText="http://127.0.0.1:5080"
                                 Padding="8,5" Margin="0,0,16,0" CornerRadius="4"/>

                        <TextBlock Grid.Column="2" Text="Branch Code" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3" Text="{Binding BranchCode, Mode=TwoWay}"
                                 IsEnabled="{Binding IsNotLoading}"
                                 PlaceholderText="BR-001"
                                 Width="110" Padding="8,5" Margin="0,0,16,0" CornerRadius="4"/>

                        <CheckBox Grid.Column="4" IsChecked="{Binding UseTestEndpoint, Mode=TwoWay}"
                                  IsEnabled="{Binding IsNotLoading}"
                                  Content="Use Test Endpoint" FontSize="12" FontWeight="Medium" Foreground="#334155"
                                  Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="5" Text="Test Mode" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                   Margin="0,0,8,0" IsVisible="{Binding UseTestEndpoint}"/>
                        <ComboBox Grid.Column="6" ItemsSource="{Binding TestModes}" SelectedItem="{Binding SelectedTestMode, Mode=TwoWay}"
                                  IsEnabled="{Binding IsNotLoading}"
                                  Width="140" IsVisible="{Binding UseTestEndpoint}" CornerRadius="4"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Operational Summary Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,12">
            <!-- Total -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0"
                    BoxShadow="0 1 3 0 #0A000000">
                <StackPanel>
                    <TextBlock Text="TOTAL SHIPMENTS" FontSize="11" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5"/>
                    <TextBlock Text="{Binding Summary.Total}" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pending -->
            <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0"
                    BoxShadow="0 1 3 0 #0A000000">
                <StackPanel>
                    <TextBlock Text="PENDING" FontSize="11" FontWeight="Bold" Foreground="#B45309" LetterSpacing="0.5"/>
                    <TextBlock Text="{Binding Summary.Pending}" FontSize="26" FontWeight="Bold" Foreground="#92400E" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- InTransit -->
            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0"
                    BoxShadow="0 1 3 0 #0A000000">
                <StackPanel>
                    <TextBlock Text="IN TRANSIT" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" LetterSpacing="0.5"/>
                    <TextBlock Text="{Binding Summary.InTransit}" FontSize="26" FontWeight="Bold" Foreground="#1E40AF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Delivered -->
            <Border Grid.Column="3" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0"
                    BoxShadow="0 1 3 0 #0A000000">
                <StackPanel>
                    <TextBlock Text="DELIVERED" FontSize="11" FontWeight="Bold" Foreground="#047857" LetterSpacing="0.5"/>
                    <TextBlock Text="{Binding Summary.Delivered}" FontSize="26" FontWeight="Bold" Foreground="#065F46" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Exception -->
            <Border Grid.Column="4" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0"
                    BoxShadow="0 1 3 0 #0A000000">
                <StackPanel>
                    <TextBlock Text="EXCEPTION" FontSize="11" FontWeight="Bold" Foreground="#B91C1C" LetterSpacing="0.5"/>
                    <TextBlock Text="{Binding Summary.Exception}" FontSize="26" FontWeight="Bold" Foreground="#991B1B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Filter & Stale Data Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                BoxShadow="0 1 3 0 #0A000000">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Status Filter:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                          Width="160" CornerRadius="4"/>

                <Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1"
                        CornerRadius="6" Padding="10,5" Margin="16,0"
                        IsVisible="{Binding HasStaleData}">
                    <TextBlock Text="{Binding StaleDataNotice}" Foreground="#92400E" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="3" Text="{Binding DisplayedShipments.Count, StringFormat='Showing {0} shipment(s)'}"
                           VerticalAlignment="Center" Foreground="#475569" FontSize="13" FontWeight="Medium"/>
            </Grid>
        </Border>

        <!-- 4. Error Alert Banner (with Retry) -->
        <Border Grid.Row="3" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                IsVisible="{Binding IsError}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#991B1B"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Retry Request"
                        Command="{Binding FetchShipmentsCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        Background="#DC2626" Foreground="#FFFFFF"
                        FontSize="12" FontWeight="SemiBold" Padding="12,6" Margin="12,0,0,0"
                        CornerRadius="4"/>
            </Grid>
        </Border>

        <!-- 5. Shipments DataGrid + Empty State -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="4" BoxShadow="0 1 4 0 #0F000000">
            <Grid>
                <DataGrid ItemsSource="{Binding DisplayedShipments}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          RowBackground="#FFFFFF">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tracking Number" Binding="{Binding TrackingNumber}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="*"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                        <DataGridTextColumn Header="Last Updated (UTC)" Binding="{Binding FormattedUtcTime}" Width="185"/>
                        <DataGridTextColumn Header="Last Updated (Local)" Binding="{Binding FormattedLocalTime}" Width="185"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Overlay -->
                <Border Background="#F8FAFC" CornerRadius="6" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        IsVisible="{Binding ShowEmptyState}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="No Shipments Displayed" FontSize="16" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyStateMessage}" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 6. Status Footer -->
        <Border Grid.Row="5" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="110" Height="6" Margin="0,0,12,0"
                             IsVisible="{Binding IsLoading}"/>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           FontWeight="Medium" FontSize="13" Foreground="#334155"/>

                <TextBlock Grid.Column="2" Text="ITSD81 Performance Task 5 — HubLink Client" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
